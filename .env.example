# Variables para docker compose. Copiar este archivo a ".env" (misma carpeta)
# y completarlo. Con Docker el servidor NO lee server/.env: usa este.

# Client ID de OAuth de Google (el mismo de server/.env)
GOOGLE_CLIENT_ID=

# Secreto para firmar la cookie de sesión (opcional)
SESSION_SECRET=

# Habilita el login sintético de k6 (/api/auth/loadtest). Solo para pruebas de carga.
LOAD_TEST_TOKEN=secreto123

# Clave del usuario admin de Grafana (por defecto: admin)
GRAFANA_ADMIN_PASSWORD=admin
