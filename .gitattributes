# Finales de línea: el repositorio guarda todo en LF (Render y Docker corren
# en Linux). Así no depende de core.autocrlf de cada PC ni aparecen diffs
# solo por CRLF/LF.
* text=auto eol=lf

# Scripts de Windows: CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binarios: nunca convertir.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.docx binary
*.pptx binary
*.zip binary
