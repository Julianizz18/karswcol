# Client ID de OAuth 2.0 (tipo "Aplicación web") creado en
# https://console.cloud.google.com/apis/credentials
# Orígenes de JavaScript autorizados: http://localhost:3000
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Secreto para firmar la cookie de sesión. Si no se define, se genera uno
# aleatorio al arrancar (las sesiones se pierden al reiniciar el servidor).
SESSION_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio
